<div class="overscroll-none">
  <% content_for :title, "Poacher: System Users" %>
  <% content_for(:page_title, "USERS") %>

  <div id="users" class="w-full md:w-4/5 lg:w-2/3 mx-auto mb-8">

    <% @users.group_by(&:dept).each do |department, users| %>
      <% sorted_users = users.sort_by(&:full_name) %>

      <div class="mt-6">

        <h2 class="mb-2 text-lg font-semibold">
          <%= department.presence || "No Department" %>
        </h2>

        <!-- Tablet / desktop: table -->
        <div class="hidden md:block">
          <table class="w-full table-fixed border text-sm text-left text-gray-600">
            <thead class="text-xs text-gray-700 uppercase bg-gray-200">
              <tr>
                <th class="w-1/5 px-3 py-2 underline">Name</th>
                <th class="w-1/5 px-3 py-2 underline">Email</th>
                <th class="w-1/5 px-3 py-2 underline">Title</th>
                <th class="w-1/10 px-3 py-2 underline">Status</th>
                <th class="w-1/10 px-3 py-2 underline">Created</th>
                <th class="w-1/5 px-3 py-2 underline">Groups</th>
                <% if can? :manage, User %>
                  <th class="w-1/10 px-3 py-2 underline"></th>
                <% end %>
              </tr>
            </thead>

            <tbody>
              <% sorted_users.each do |user| %>
                <tr class="border-b hover:bg-gray-100">

                  <td class="px-6 py-4 whitespace-nowrap">
                    <%= user.full_name %>
                  </td>

                  <td class="px-4 py-3 truncate">
                    <%= user.email %>
                  </td>

                  <td class="px-4 py-3">
                    <%= user.title %>
                  </td>

                  <td class="px-4 py-3">
                    <%= employment_status_pill(user.employment_status) %>
                  </td>

                  <td class="px-4 py-3">
                    <%= user.created_at.to_formatted_s(:uk_clean_date) %>
                  </td>

                  <td class="px-4 py-3">
                    <%= group_pills(user) %>
                  </td>

                  <% if can? :manage, User %>
                    <td class="px-4 py-3">
                      <%= link_to "Edit", edit_user_path(user), class: link_class %>
                    </td>
                  <% end %>

                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <!-- Mobile: cards -->
        <div class="md:hidden space-y-3">
          <% sorted_users.each do |user| %>
            <div class="border rounded-lg p-4 shadow-sm bg-white">
              <div class="flex items-start justify-between gap-2 mb-1">
                <h3 class="font-semibold text-gray-900"><%= user.full_name %></h3>
                <%= employment_status_pill(user.employment_status) %>
              </div>

              <p class="text-xs text-gray-500 mb-2 truncate"><%= user.email %></p>

              <dl class="text-sm text-gray-600 space-y-1">
                <% if user.title.present? %>
                  <div class="flex justify-between gap-4">
                    <dt class="text-gray-400">Title</dt>
                    <dd class="text-right"><%= user.title %></dd>
                  </div>
                <% end %>
                <div class="flex justify-between gap-4">
                  <dt class="text-gray-400">Created</dt>
                  <dd class="text-right"><%= user.created_at.to_formatted_s(:uk_clean_date) %></dd>
                </div>
              </dl>

              <div class="mt-2 pt-2 border-t">
                <div class="text-gray-400 text-xs mb-1">Groups</div>
                <%= group_pills(user) %>
              </div>

              <% if can? :manage, User %>
                <div class="mt-3 pt-3 border-t text-right">
                  <%= link_to "Edit", edit_user_path(user), class: link_class %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

      </div>
    <% end %>

  </div>
</div>
