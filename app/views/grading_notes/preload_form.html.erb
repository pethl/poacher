<div class="max-w-xl mx-auto mt-6 bg-white p-4 rounded shadow">
  <h2 class="text-xl font-semibold mb-4">Start Grading Session</h2>

  <%= form_with url: create_preload_grading_notes_path, method: :post, local: true do |form| %>

  <div class="grid grid-cols-2 gap-x-5 gap-y-4 items-center">

    <!-- Start from Make Date -->
    <label class="text-right font-semibold text-gray-700">
      <%= form.label :start_date, "Start from Make Date" %>
    </label>

    <div>
      <%= form.date_field :start_date,
          value: @start_date,
          class: field_class_flex %>
    </div>


    <!-- Batch Count -->
    <label class="text-right font-semibold text-gray-700">
      How many batches would you like to preload?
    </label>

    <div>
      <%= form.select :batch_count,
          options_for_select([3,4,5], selected: 5),
          {},
          class: field_class_flex_med %>
    </div>


    <!-- Head Taster -->
    <label class="text-right font-semibold text-gray-700">
      <%= form.label :head_taster_id, "Head Taster" %>
    </label>

    <div>
      <%= form.collection_select :head_taster_id,
          @users,
          :id,
          :full_name,
          { prompt: "Select Head Taster" },
          class: field_class_flex %>
    </div>


    <!-- Taster 1 -->
    <label class="text-right font-semibold text-gray-700">
      Taster 1:
    </label>

    <div>
      <%= form.text_field :taster_1_name,
          class: field_class_flex,
          placeholder: "Optional" %>
    </div>


    <!-- Taster 2 -->
    <label class="text-right font-semibold text-gray-700">
      Taster 2:
    </label>

    <div>
      <%= form.text_field :taster_2_name,
          class: field_class_flex,
          placeholder: "Optional" %>
    </div>


    <!-- Buttons -->
    <div class="col-span-2 text-right mt-4">
      <%= link_to "← Back to Store Home",
          pages_store_home_path,
          class: gray_button %>

      <%= form.submit "Preload Grading Notes",
          class: fill_button_class %>
    </div>

  </div>

  <% end %>
</div>