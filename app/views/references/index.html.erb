<% content_for :title, "Poacher: Reference Data" %>
<% content_for :page_title, "REFERENCE DATA" %>

<div class="mx-auto w-full max-w-full lg:w-2/3 px-4 overflow-x-hidden">

  <!-- FILTER CONTROLLER -->
  <div data-controller="filter" class="my-4 w-full max-w-full min-w-0">

    <div class="flex flex-wrap items-center gap-4 w-full min-w-0">

      <!-- SEARCH INPUT -->
      <div class="w-full sm:w-auto min-w-0">
        <label for="search" class="sr-only">Search</label>

        <input type="text" name="search" id="search" placeholder="Search values..." data-filter-target="input" data-action="input->filter#filter" class="<%= field_class_flex %> w-full sm:w-64 max-w-full" />
      </div>

      <!-- FILTER FORM -->
      <%= form_with(url: references_path,
                    method: :get,
                    local: true,
                    class: "flex flex-wrap items-end gap-2 w-full sm:w-auto min-w-0") do %>

      <!-- Model -->
      <div class="min-w-0">
        <%= label_tag :model,
                "Model",
                class: "block text-[11px] font-medium text-gray-600" %>

        <%= select_tag :model,
                options_for_select(reference_model_options, params[:model]),
                prompt: "Select",
                class: "#{field_class_flex} max-w-full" %>
      </div>

      <!-- Group -->
      <div class="min-w-0">
        <%= label_tag :group,
                "Group",
                class: "block text-[11px] font-medium text-gray-600" %>

        <%= select_tag :group,
                options_for_select(
                  Reference.distinct.pluck(:group).sort,
                  params[:group]
                ),
                prompt: "Select",
                class: "#{field_class_flex} max-w-full" %>
      </div>

      <!-- Filter Buttons -->
      <div class="flex gap-1 sm:mt-5">
        <%= submit_tag "Filter", class: fill_button_class %>

        <%= link_to "Clear",
                references_path,
                class: clear_button_class %>
      </div>

      <% end %>
    </div>
  </div>

  <!-- Intro text -->
  <p class="text-base text-left font-light mb-4">
    IMPORTANT: values cannot be deleted, they can be made
    <strong>Inactive.</strong><br>

    When adding a new value you must assign the correct
    <strong>model</strong>,
    <strong>group</strong>,
    and mark as <strong>Active</strong> for it to show up in the system.
  </p>

  <!-- Add New Instructions -->
  <div class="mb-6">
    <b>Open relevant section to Add New Reference.</b>
  </div>


  <!-- MODEL + GROUP LOOP -->
  <% @references_by_model_and_group.each do |model, grouped_references| %>

  <div class="text-xl font-bold text-gray-800 mb-2 mt-6">
    <%= model %>
  </div>

  <% grouped_references.each do |group, references| %>

  <div data-filter-target="item" data-filter-value="<%= references.map(&:value).join(' ').parameterize %>" class="w-full max-w-full min-w-0">

    <!-- Accordion -->
    <div data-controller="accordion" class="mt-2 border border-gray-200 rounded-lg shadow bg-white overflow-hidden w-full max-w-full">

      <!-- Accordion Header -->
      <button type="button" data-action="click->accordion#toggle" class="w-full text-left px-4 py-3 bg-gray-100 hover:bg-gray-200 font-semibold text-gray-800 text-sm border-b transition" aria-expanded="false">

        <%= group %>

      </button>

      <!-- Accordion Body -->
      <div data-accordion-target="section" class="px-4 py-4 hidden transition-all duration-200 ease-in-out min-w-0">

        <!-- Add New -->
        <div class="mb-4">
          <%= link_to "Add new to #{group}",
                    new_reference_path(model: model, group: group),
                    class: gray_button %>
        </div>


        <% if references.any? %>

        <!--
                Keep wide reference tables contained.
                Only the table scrolls horizontally on small screens.
              -->
        <div class="w-full max-w-full overflow-x-auto">

          <table class="w-full min-w-[520px] text-left text-sm">

            <thead class="text-xs bg-gray-200 text-gray-500 uppercase border-b">
              <tr>
                <th class="px-4 py-2 w-48">
                  Value
                </th>

                <th class="px-4 py-2 w-48">
                  Description
                </th>

                <th class="px-4 py-2 w-20">
                  Sort Order
                </th>

                <th class="px-4 py-2 w-20">
                  Active?
                </th>
              </tr>
            </thead>

            <tbody>

              <% references.each do |reference| %>

              <tr class="border-b hover:bg-gray-50">

                <td class="px-4 py-2">
                  <%= link_to reference.value,
                                edit_reference_path(reference),
                                class: link_class %>
                </td>

                <td class="px-4 py-2">
                  <%= reference.description %>
                </td>

                <td class="px-4 py-2">
                  <%= reference.sort_order %>
                </td>

                <td class="px-4 py-2">
                  <%= reference.active? ? "Yes" : "No" %>
                </td>

              </tr>

              <% end %>

            </tbody>

          </table>

        </div>

        <% else %>

        <p class="text-sm text-gray-500 italic">
          No entries found for this group.
        </p>

        <% end %>

      </div>
    </div>

  </div>

  <% end %>
  <% end %>

</div>