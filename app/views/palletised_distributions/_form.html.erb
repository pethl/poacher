<div class="w-full max-w-2xl mx-auto mt-6 bg-white p-4 sm:p-6 overflow-x-hidden">
  <%= form_with(model: palletised_distribution, local: true) do |form| %>

  <%= form_errors_for(palletised_distribution) %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 sm:gap-y-4 items-center">

    <!-- Date -->
    <label class="text-left sm:text-right font-semibold text-gray-700">
      <%= form.label :date %>
    </label>
    <div class="min-w-0">
      <%= form.date_field :date,
              class: "#{field_class_flex} w-full max-w-full" %>
    </div>

    <!-- Company Name -->
    <label class="text-left sm:text-right font-semibold text-gray-700">
      <%= form.label :company_name %>
    </label>
    <div class="min-w-0">
      <%= form.text_field :company_name,
              class: "#{field_class_flex} w-full max-w-full" %>
    </div>

    <!-- Registration -->
    <label class="text-left sm:text-right font-semibold text-gray-700">
      <%= form.label :registration %>
    </label>
    <div class="min-w-0">
      <%= form.text_field :registration,
              class: "#{field_class_flex} w-full max-w-full" %>
    </div>

    <!-- Trailer Number / Type -->
    <label class="text-left sm:text-right font-semibold text-gray-700">
      <%= form.label :trailer_number_type, "Trailer Number / Type" %>
    </label>
    <div class="min-w-0">
      <%= form.text_field :trailer_number_type,
              class: "#{field_class_flex} w-full max-w-full" %>
    </div>

    <!-- Temperature -->
    <label class="text-left sm:text-right font-semibold text-gray-700">
      <%= form.label :temperature, "Temperature °C" %>
    </label>
    <div class="min-w-0">
      <%= form.text_field :temperature,
              class: "#{field_class_flex_small} w-full sm:w-auto max-w-full" %>
    </div>

    <!-- Vehicle Clean -->
    <label class="text-left sm:text-right font-semibold text-gray-700">
      <%= form.label :vehicle_clean, "Vehicle Clean, free of taint?" %>
    </label>
    <div class="min-w-0">
      <%= form.select :vehicle_clean,
              options_for_select(
                yes_no,
                palletised_distribution.vehicle_clean
              ),
              { include_blank: true },
              class: "#{field_class_flex_small} w-full sm:w-auto max-w-full" %>
    </div>

    <!-- Destination -->
    <label class="text-left sm:text-right font-semibold text-gray-700">
      <%= form.label :destination %>
    </label>
    <div class="min-w-0">
      <%= form.text_field :destination,
              class: "#{field_class_flex} w-full max-w-full" %>
    </div>

    <!-- Number of Pallets -->
    <label class="text-left sm:text-right font-semibold text-gray-700">
      <%= form.label :number_of_pallets %>
    </label>
    <div class="min-w-0">
      <%= form.number_field :number_of_pallets,
              class: "#{field_class_flex_small} w-full sm:w-auto max-w-full" %>
    </div>

    <!-- Checked By -->
    <label class="text-left sm:text-right font-semibold text-gray-700">
      Checked By
    </label>
    <div class="min-w-0">
      <%= text_field_tag :checked_by,
              current_user.full_name,
              readonly: true,
              class: "#{field_class_flex} w-full max-w-full" %>
    </div>


    <!-- Staff Signature -->
    <div class="col-span-1 sm:col-span-2 mt-4 min-w-0">
      <div data-controller="signature" class="flex flex-col items-center space-y-4 p-3 sm:p-4 border rounded-lg bg-gray-50 w-full max-w-full min-w-0">

        <p class="text-md font-semibold">
          Staff Signature
        </p>

        <canvas width="400" height="200" class="border border-gray-400 rounded bg-white shadow-sm w-full max-w-[400px] h-auto touch-none">
        </canvas>

        <%= form.hidden_field :staff_signature,
                class: "signature-input" %>

        <button type="button" class="clear-signature text-sm text-gray-500 hover:text-gray-700 underline">
          Clear Signature
        </button>

      </div>
    </div>


    <!-- Driver Signature -->
    <div class="col-span-1 sm:col-span-2 mt-4 min-w-0">
      <div data-controller="signature" class="flex flex-col items-center space-y-4 p-3 sm:p-4 border rounded-lg bg-gray-50 w-full max-w-full min-w-0">

        <p class="text-md font-semibold">
          Driver Signature
        </p>

        <canvas width="400" height="200" class="border border-gray-400 rounded bg-white shadow-sm w-full max-w-[400px] h-auto touch-none">
        </canvas>

        <%= form.hidden_field :driver_signature,
                class: "signature-input" %>

        <button type="button" class="clear-signature text-sm text-gray-500 hover:text-gray-700 underline">
          Clear Signature
        </button>

      </div>
    </div>


    <!-- Action Buttons -->
    <div class="mt-3 sm:mt-2">
      <%= link_to "← Back to Index",
              palletised_distributions_path,
              class: clear_button_class %>
    </div>

    <div class="mt-2">
      <%= form.submit "Save Record",
              class: fill_button_class %>
    </div>

  </div>

  <% end %>
</div>