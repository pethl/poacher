<div class="overscroll-none w-full max-w-full overflow-x-hidden">
  <% content_for :title, "Validation Ranges" %>
  <% content_for(:page_title, "VALIDATION RANGES") %>
  <% content_for(:page_button, new_validation_range_path) %>

  <div id="validation_ranges" class="mx-auto w-full max-w-full lg:w-2/3 px-4 min-w-0">

    <!-- Intro -->
    <p class="mx-auto mb-4 text-base text-center font-light">
      These ranges are used to validate critical field values dynamically.
      Update them cautiously.
    </p>


    <!-- Model Filters -->
    <% unique_models = @validation_ranges.map(&:target_model).uniq.sort %>

    <div class="mb-4 flex flex-wrap gap-2 justify-center">

      <%= link_to "All",
            validation_ranges_path,
            class: "px-3 sm:px-4 py-2 rounded-full text-xs sm:text-sm font-medium #{params[:model].blank? ? 'bg-gray-600 text-white' : 'bg-gray-200'}" %>

      <% unique_models.each do |model| %>

      <%= link_to model,
              validation_ranges_path(model: model),
              class: "px-3 sm:px-4 py-2 rounded-full text-xs sm:text-sm font-medium #{params[:model] == model ? 'bg-gray-600 text-white' : 'bg-gray-200'}" %>

      <% end %>

    </div>


    <!--
      Table container:
      page stays fixed; only this area scrolls horizontally.
    -->
    <div class="w-full max-w-full border rounded shadow-sm mb-12 min-h-[50vh] max-h-[calc(100vh-240px)] overflow-y-auto">

      <table class="w-full table-auto text-xs sm:text-sm">

        <thead class="sticky top-0 bg-gray-200 text-xs text-gray-700 uppercase z-10">
          <tr>

            <th class="px-2 sm:px-4 py-3 text-left">
              Field
            </th>

            <th class="px-2 sm:px-4 py-3 text-left">
              Min
            </th>

            <th class="px-2 sm:px-4 py-3 text-left">
              Max
            </th>

            <th class="px-2 sm:px-4 py-3 text-left">
              Active
            </th>

            <!-- Hide audit columns on mobile -->
            <th class="hidden md:table-cell px-4 py-3 text-left">
              Created By
            </th>

            <th class="hidden md:table-cell px-4 py-3 text-left">
              Updated By
            </th>

            <th class="px-2 sm:px-4 py-3 text-left">
            </th>

          </tr>
        </thead>

        <tbody>

          <% @validation_ranges.each do |vr| %>

          <tr class="bg-white border-b hover:bg-gray-100">

            <!-- Field -->
            <td class="px-2 sm:px-4 py-3 text-left break-words">
              <%= link_to vr.field_name,
                  vr,
                  class: "underline underline-offset-2" %>
            </td>

            <!-- Min -->
            <td class="px-2 sm:px-4 py-3 text-left">
              <%= vr.min_value %>
            </td>

            <!-- Max -->
            <td class="px-2 sm:px-4 py-3 text-left">
              <%= vr.max_value %>
            </td>

            <!-- Active -->
            <td class="px-2 sm:px-4 py-3 text-left">
              <% if vr.active? %>
              <span class="text-green-600 font-medium">
                Yes
              </span>
              <% else %>
              <span class="text-red-600 font-medium">
                No
              </span>
              <% end %>
            </td>

            <!-- Created By - tablet/desktop only -->
            <td class="hidden md:table-cell px-4 py-3 text-left">
              <%= vr.created_by&.full_name || "—" %>
            </td>

            <!-- Updated By - tablet/desktop only -->
            <td class="hidden md:table-cell px-4 py-3 text-left">
              <%= vr.updated_by&.full_name || "—" %>
            </td>

            <!-- Edit -->
            <td class="px-2 sm:px-4 py-3 text-left">
              <%= link_to "Edit",
                  edit_validation_range_path(vr),
                  class: "underline underline-offset-2 text-blue-600" %>
            </td>

          </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>
</div>

<br>